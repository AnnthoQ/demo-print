# Copia este archivo como .env y completa los valores. .env NUNCA va al repositorio.

# Token que la extensión envía en "Authorization: Bearer <token>" (mínimo 16 caracteres).
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=6B--nB4xJpE8IVa945ODCiKt52SkEEYaw7P-hmJdAE4

# Comunidades SNMP de SOLO LECTURA (referenciadas desde config/printers.json como env:...)
SNMP_COMMUNITY_CANON=public
SNMP_COMMUNITY_RICOH=public
SNMP_COMMUNITY_KONICA=public

# Red: 0.0.0.0 para que la usen otros equipos de la oficina; 127.0.0.1 solo este equipo
HOST=0.0.0.0
PORT=8787

# Orígenes permitidos por CORS, separados por coma (ID visible en chrome://extensions)
ALLOWED_ORIGINS=chrome-extension://*

# Sondeo
POLL_INTERVAL=5
SNMP_TIMEOUT=2
SNMP_RETRIES=1
LOW_PAPER_THRESHOLD=20

# Rutas (relativas a la raíz del proyecto)
PRINTERS_FILE=config/printers.json
TRAYS_FILE=config/trays.json
