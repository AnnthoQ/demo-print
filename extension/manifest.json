{
  "manifest_version": 3,
  "name": "Monitor de impresoras",
  "version": "1.3.0",
  "description": "Estado, papel por bandeja y avisos de atasco de las impresoras de la oficina.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Monitor de impresoras",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["alarms", "notifications", "storage", "offscreen", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "minimum_chrome_version": "109"
}
